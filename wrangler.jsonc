{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulso-web",
  "main": "deployment/cloudflare/worker.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".local/cloudflare-setup/site",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/*.html",
      "/releases/*",
      "/assets/session.worker-*",
      "/sw.js",
      "/catalog/*",
      "/catalog-config.json",
      "/account-config.json",
      "/api/account-auth/*",
      "/api/account-profile",
      "/api/account-library",
      "/api/spotify-playlist/*",
      "/api/spotify-track/*",
      "/api/youtube-playlist",
      "/telegram-config.json"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CATALOG",
        "class_name": "CatalogCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CatalogCoordinator"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "PULSO_AUTH_EMAIL_LIMIT",
      "namespace_id": "21801",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "PULSO_AUTH_ATTEMPT_LIMIT",
      "namespace_id": "21802",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "PULSO_ACCOUNT_WRITE_LIMIT",
      "namespace_id": "21803",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "PULSO_SPOTIFY_LIMIT",
      "namespace_id": "21804",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
