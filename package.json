{
  "name": "pulso-web",
  "version": "0.1.0",
  "description": "Piloto local de audio de Pulso Web",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "build": "vite build && node scripts/build-sw.mjs",
    "test:browser": "node scripts/browser-build.mjs",
    "test:browser:run": "node scripts/run-browser-tests.mjs",
    "build:cloudflare": "node scripts/prepare-cloudflare.mjs",
    "test:cloudflare": "node --test tests/server/cloudflare-*.test.mjs",
    "deploy:cloudflare": "wrangler deploy --config wrangler.jsonc"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@mtcute/web": "0.32.7",
    "@noble/hashes": "2.4.0",
    "music-metadata": "12.3.2",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@ffmpeg-installer/linux-x64": "4.1.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsqr": "1.4.0",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.161.0"
  },
  "private": true,
  "type": "module"
}
